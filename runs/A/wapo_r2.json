      "annotations": [],
      "text": "{\n  \"legal_owner\": {\n    \"status\": \"established\",\n    \"names\": [\"WP Company LLC (doing business as The Washington Post)\"],\n    \"citations\": [\n      {\n        \"url\": \"https://whca.press/wp-content/uploads/2025/10/2025.10.06-AMICUS-FOR-APPELLEE-BRIEF-2139056-filed-by-Reporters-Committee-for.pdf\",\n        \"quote\": \"WP Company LLC d/b/a The Washington Post is a wholly-owned subsidiary of Nash Holdings LLC\"\n      }\n    ]\n  },\n  \"operator\": {\n    \"status\": \"same_as_owner\",\n    \"names\": [\"WP Company LLC\"],\n    \"citations\": [\n      {\n        \"url\": \"https://www.washingtonpost.com/terms-of-service/?itid=mr_information_1\",\n        \"quote\": \"These terms are a legal contract between you and WP Company LLC (\u201cThe Washington Post,\u201d \u201cwe\u201d or \u201cus\u201d)\"\n      }\n    ]\n  },\n  \"chain\": [\n    {\n      \"child\": \"WP Company LLC\",\n      \"parent\": \"Nash Holdings LLC\",\n      \"relation\": \"Wholly owned subsidiary\",\n      \"citations\": [\n        {\n          \"url\": \"https://whca.press/wp-content/uploads/2025/10/2025.10.06-AMICUS-FOR-APPELLEE-BRIEF-2139056-filed-by-Reporters-Committee-for.pdf\",\n          \"quote\": \"WP Company LLC d/b/a The Washington Post is a wholly-owned subsidiary of Nash Holdings LLC\"\n        }\n      ]\n    }\n  ],\n  \"ultimate_parent\": {\n    \"status\": \"single\",\n    \"names\": [\"Nash Holdings LLC\"],\n    \"citations\": [\n      {\n        \"url\": \"https://whca.press/wp-content/uploads/2025/10/2025.10.06-AMICUS-FOR-APPELLEE-BRIEF-2139056-filed-by-Reporters-Committee-for.pdf\",\n        \"quote\": \"Nash Holdings LLC, a holding company owned by Jeffrey P. Bezos.\"\n      }\n    ]\n  },\n  \"controlling_person\": {\n    \"status\": \"established\",\n    \"names\": [\"Jeffrey P. Bezos (Jeff Bezos)\"],\n    \"citations\": [\n      {\n        \"url\": \"https://whca.press/wp-content/uploads/2025/10/2025.10.06-AMICUS-FOR-APPELLEE-BRIEF-2139056-filed-by-Reporters-Committee-for.pdf\",\n        \"quote\": \"Nash Holdings LLC, a holding company owned by Jeffrey P. Bezos.\"\n      },\n      {\n        \"url\": \"https://corporate.washingtonpost.com/about\",\n        \"quote\": \"The Washington Post is owned by Jeff Bezos, executive chairman of Amazon.\"\n      }\n    ]\n  },\n  \"leader\": {\n    \"status\": \"established\",\n    \"name\": \"Jeff D\u2019Onofrio\",\n    \"role\": \"Publisher and Chief Executive Officer\",\n    \"entity\": \"The Washington Post\",\n    \"citations\": [\n      {\n        \"url\": \"https://www.washingtonpost.com/business/2026/09/09/interim-washington-post-publisher-jeff-donofrio-serve-permanent-capacity/\",\n        \"quote\": \"Jeff D\u2019Onofrio was named publisher and CEO of The Washington Post on Wednesday following a seven-month stint serving in an interim capacity.\"\n      },\n      {\n        \"url\": \"https://corporate.washingtonpost.com/about\",\n        \"quote\": \"Jeff D\u2019Onofrio\\nPublisher & CEO\"\n      }\n    ]\n  },\n  \"transactions\": [\n    {\n      \"description\": \"Agreement announced for Nash Holdings LLC to acquire the publishing subsidiaries, including WP Company LLC, from The Washington Post Company.\",\n      \"status\": \"announced\",\n      \"date\": \"2013-08-05\",\n      \"citations\": [\n        {\n          \"url\": \"https://www.ghco.com/static-files/fa88319a-6162-4466-8d86-af13a725cdf9\",\n          \"quote\": \"On August 5, 2013, after approval by the Company\u2019s Board of Directors on the same day, the Company announced\"\n        }\n      ]\n    },\n    {\n      \"description\": \"Nash Holdings LLC completed the $250 million acquisition of the publishing subsidiaries, including WP Company LLC.\",\n      \"status\": \"closed\",\n      \"date\": \"2013-10-01\",\n      \"citations\": [\n        {\n          \"url\": \"https://www.ghco.com/static-files/fa88319a-6162-4466-8d86-af13a725cdf9\",\n          \"quote\": \"On October 1, 2013, the Company entered into a Purchase Agreement and completed the sale.\"\n        },\n        {\n          \"url\": \"https://www.ghco.com/static-files/fa88319a-6162-4466-8d86-af13a725cdf9\",\n          \"quote\": \"the Purchaser acquired all the issued and outstanding equity securities of each of the entities that comprise the Publishing Subsidiaries for $250 million\"\n        }\n      ]\n    }\n  ],\n  \"uncertainty\": \"As of October 4, 2026, the documented corporate chain is WP Company LLC \u2192 Nash Holdings LLC, with Jeff Bezos as the natural-person owner and controller. Amazon is not identified as an ownership-chain entity. The detailed corporate relationship is supported by an October 6, 2025 court disclosure and corroborated by current company ownership information. D\u2019Onofrio became permanent publisher and CEO on September 9, 2026; describing him as merely acting or interim would be outdated.\"\n}",
